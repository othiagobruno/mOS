#!/bin/bash
# mOS: /usr/bin/security — o CLI que o ProxyResolver e o osxkeychain chamam
# (security find-certificate -a -p). Não é o Security.framework.
case "${1:-}" in
    find-certificate)
        echo "-----BEGIN CERTIFICATE-----"
        echo "-----END CERTIFICATE-----"
        ;;
    *)
        echo "security: comando mínimo do mOS. uso: security find-certificate -a -p" >&2
        exit 1
        ;;
esac
