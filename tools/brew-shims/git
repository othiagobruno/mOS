#!/bin/bash
# mOS: git mínimo quando o bottle do Homebrew (~619 MiB, hardlinks de libexec/git-core)
# não está na máquina. Um bottle passado a tools/stage-image.sh --bottles substitui este
# arquivo por bin/git uma vez; as cópias do mesmo tamanho viram #mOS-link:.
case "${1:-}" in
    --version)
        echo "git version 2.47.0 (mOS shim)"
        ;;
    init)
        dir="${2:-.}"
        mkdir -p "$dir/.git"
        echo "Initialized empty Git repository in $dir/.git/"
        ;;
    *)
        echo "git: comando mínimo do mOS. uso: git --version | git init [dir]" >&2
        exit 1
        ;;
esac
